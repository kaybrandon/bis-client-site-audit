@inject PhotoService Photos

<div>
    <div class="item-actions">
        <label class="btn btn-ghost-dark btn-sm">
            📷 Take photo
            <InputFile OnChange="Upload" accept="image/*" style="display:none" />
        </label>
        <button type="button" class="btn btn-ghost-dark btn-icon" title="Gallery" @onclick="Toggle">🖼</button>
    </div>
    @if (!string.IsNullOrEmpty(Error))
    {
        <p class="muted" style="color:var(--danger)">@Error</p>
    }
    @if (ShowGallery)
    {
        <div class="photo-grid" style="margin-top:10px;min-width:240px">
            @if (Items.Count == 0)
            {
                <p class="muted">No photos yet.</p>
            }
            @foreach (var p in Items)
            {
                <figure class="photo-tile">
                    <img src="@p.PublicUrl" alt="@p.Caption" />
                    <figcaption>
                        @p.FileName
                        <button type="button" class="btn btn-danger btn-sm" @onclick="() => Delete(p.Id)">Delete</button>
                    </figcaption>
                </figure>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid AuditId { get; set; }
    [Parameter] public Guid? OwnerId { get; set; }
    [Parameter] public string OwnerType { get; set; } = PhotoOwnerTypes.Audit;
    [Parameter] public string Category { get; set; } = "General";
    [Parameter] public EventCallback Changed { get; set; }

    private List<SitePhoto> Items { get; set; } = [];
    private bool ShowGallery { get; set; }
    private string? Error { get; set; }

    protected override async Task OnParametersSetAsync() => await Reload();

    private async Task Toggle()
    {
        ShowGallery = !ShowGallery;
        if (ShowGallery) await Reload();
    }

    private async Task Reload()
    {
        if (AuditId == Guid.Empty) return;
        Items = OwnerId is null && OwnerType == PhotoOwnerTypes.Audit
            ? await Photos.ForAuditAsync(AuditId)
            : await Photos.ForOwnerAsync(AuditId, OwnerType, OwnerId);
    }

    private async Task Upload(InputFileChangeEventArgs e)
    {
        Error = null;
        try
        {
            var file = e.File;
            if (file.Size > 8_000_000)
            {
                Error = "Photo must be 8 MB or smaller.";
                return;
            }

            await using var stream = file.OpenReadStream(8_000_000);
            await Photos.SaveAsync(AuditId, stream, file.Name, file.ContentType, Category, OwnerType, OwnerId);
            ShowGallery = true;
            await Reload();
            await Changed.InvokeAsync();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
    }

    private async Task Delete(Guid id)
    {
        await Photos.DeleteAsync(id);
        await Reload();
        await Changed.InvokeAsync();
    }
}
