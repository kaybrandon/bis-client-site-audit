<label class="fld @(Full ? "full" : null)">
    @Label
    <InputSelect Value="Value" ValueChanged="ValueChanged" ValueExpression="ValueExpression">
        <option value="">Select…</option>
        @foreach (var option in Options)
        {
            <option value="@option">@option</option>
        }
    </InputSelect>
</label>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<string?>>? ValueExpression { get; set; }
    [Parameter] public IEnumerable<string> Options { get; set; } = [];
    [Parameter] public bool Full { get; set; }
}
