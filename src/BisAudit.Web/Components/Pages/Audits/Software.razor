@page "/audits/{Id:guid}/software"
@layout AuditLayout
@attribute [Authorize]
@rendermode InteractiveServer
@inject AuditService Audits
@inject DropdownService Dropdowns
@inject IJSRuntime Js

<PageTitle>Software & Licensing</PageTitle>

<div class="toolbar">
    <div>
        <h2>Software & Licensing</h2>
        <p class="count">@Items.Count documented items</p>
    </div>
    <button type="button" class="btn btn-primary" @onclick="NewItem">+ Add item</button>
</div>

@if (Items.Count == 0) { <div class="empty">No software or licensing items documented yet.</div> }

@foreach (var item in Items)
{
    <ItemCard Title="@item.DisplayTitle" Detail="@item.DisplayDetail" PrimaryBadge="@item.Status"
              NeedsAttention="item.NeedsAttention" LastAudited="item.LastAudited"
              OnEdit="() => Edit(item)" OnDelete="() => Delete(item)">
        <PhotoContent>
            <PhotoAttach AuditId="Id" OwnerId="item.Id" OwnerType="@PhotoOwnerTypes.Software" Category="General" />
        </PhotoContent>
    </ItemCard>
}

@if (Draft is not null)
{
    <ModalFrame Title="Software / account" OnSave="Save" OnCancel="() => Draft = null">
        <div class="form-grid">
            <label class="fld">Software / Account <InputText @bind-Value="Draft.SoftwareAccount" /></label>
            <label class="fld">Account / Owner <InputText @bind-Value="Draft.AccountOwner" /></label>
            <SelectField Label="Status" @bind-Value="Draft.Status" Options="Statuses" />
            <label class="fld full">Current State <InputTextArea @bind-Value="Draft.CurrentState" /></label>
            <label class="fld full">Recommended Direction <InputTextArea @bind-Value="Draft.RecommendedDirection" /></label>
            <label class="fld full">Action Item <InputTextArea @bind-Value="Draft.ActionItem" /></label>
            <label class="fld check"><InputCheckbox @bind-Value="Draft.NeedsAttention" /> Needs Attention</label>
        </div>
    </ModalFrame>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private List<SoftwareItem> Items { get; set; } = [];
    private SoftwareItem? Draft { get; set; }
    private List<string> Statuses { get; set; } = [];

    protected override async Task OnParametersSetAsync()
    {
        Statuses = await Dropdowns.OptionsAsync(DropdownKeys.SoftwareStatus);
        await Reload();
    }

    private async Task Reload() => Items = (await Audits.GetAsync(Id))?.SoftwareItems.ToList() ?? [];
    private void NewItem() => Draft = new SoftwareItem { AuditId = Id, Status = "Current" };
    private void Edit(SoftwareItem item) => Draft = new SoftwareItem
    {
        Id = item.Id, AuditId = item.AuditId, SoftwareAccount = item.SoftwareAccount, AccountOwner = item.AccountOwner,
        CurrentState = item.CurrentState, RecommendedDirection = item.RecommendedDirection, ActionItem = item.ActionItem,
        Status = item.Status, LastAudited = item.LastAudited, NeedsAttention = item.NeedsAttention
    };

    private async Task Save()
    {
        if (Draft is null) return;
        await Audits.SaveItemAsync(Draft);
        Draft = null;
        await Reload();
    }

    private async Task Delete(SoftwareItem item)
    {
        if (!await Js.InvokeAsync<bool>("confirm", "Delete this item?")) return;
        await Audits.DeleteItemAsync<SoftwareItem>(item.Id);
        await Reload();
    }
}
