@page "/audits/{Id:guid}/security"
@layout AuditLayout
@attribute [Authorize]
@rendermode InteractiveServer
@inject AuditService Audits
@inject DropdownService Dropdowns
@inject IJSRuntime Js

<PageTitle>Security, Cameras & AV</PageTitle>

<div class="toolbar">
    <div>
        <h2>Security, Cameras & AV</h2>
        <p class="count">@Items.Count documented items</p>
    </div>
    <button type="button" class="btn btn-primary" @onclick="NewItem">+ Add item</button>
</div>

@if (Items.Count == 0) { <div class="empty">No security, camera, or AV items documented yet.</div> }

@foreach (var item in Items)
{
    <ItemCard Title="@item.DisplayTitle" Detail="@item.DisplayDetail" PrimaryBadge="@item.Category" SecondaryBadge="@item.Status"
              NeedsAttention="item.NeedsAttention" LastAudited="item.LastAudited"
              OnEdit="() => Edit(item)" OnDelete="() => Delete(item)">
        <PhotoContent>
            <PhotoAttach AuditId="Id" OwnerId="item.Id" OwnerType="@PhotoOwnerTypes.SecurityAv" Category="Security/Camera" />
        </PhotoContent>
    </ItemCard>
}

@if (Draft is not null)
{
    <ModalFrame Title="Security / camera / AV" OnSave="Save" OnCancel="() => Draft = null">
        <div class="form-grid">
            <label class="fld">Device Name <InputText @bind-Value="Draft.DeviceName" /></label>
            <SelectField Label="Category" @bind-Value="Draft.Category" Options="Categories" />
            <SelectField Label="Status" @bind-Value="Draft.Status" Options="Statuses" />
            <label class="fld full">Current State <InputTextArea @bind-Value="Draft.CurrentState" /></label>
            <label class="fld full">Recommendation <InputTextArea @bind-Value="Draft.Recommendation" /></label>
            <label class="fld check"><InputCheckbox @bind-Value="Draft.NeedsAttention" /> Needs Attention</label>
        </div>
    </ModalFrame>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private List<SecurityAvItem> Items { get; set; } = [];
    private SecurityAvItem? Draft { get; set; }
    private List<string> Categories { get; set; } = [];
    private List<string> Statuses { get; set; } = [];

    protected override async Task OnParametersSetAsync()
    {
        Categories = await Dropdowns.OptionsAsync(DropdownKeys.SecurityCategory);
        Statuses = await Dropdowns.OptionsAsync(DropdownKeys.SecurityStatus);
        await Reload();
    }

    private async Task Reload() => Items = (await Audits.GetAsync(Id))?.SecurityAvItems.ToList() ?? [];
    private void NewItem() => Draft = new SecurityAvItem { AuditId = Id, Status = "Current" };
    private void Edit(SecurityAvItem item) => Draft = new SecurityAvItem
    {
        Id = item.Id, AuditId = item.AuditId, DeviceName = item.DeviceName, Category = item.Category,
        CurrentState = item.CurrentState, Recommendation = item.Recommendation, Status = item.Status,
        LastAudited = item.LastAudited, NeedsAttention = item.NeedsAttention
    };

    private async Task Save()
    {
        if (Draft is null) return;
        await Audits.SaveItemAsync(Draft);
        Draft = null;
        await Reload();
    }

    private async Task Delete(SecurityAvItem item)
    {
        if (!await Js.InvokeAsync<bool>("confirm", "Delete this item?")) return;
        await Audits.DeleteItemAsync<SecurityAvItem>(item.Id);
        await Reload();
    }
}
