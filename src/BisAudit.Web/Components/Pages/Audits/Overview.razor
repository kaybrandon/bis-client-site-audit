@page "/audits/{Id:guid}/overview"
@layout AuditLayout
@attribute [Authorize]
@rendermode InteractiveServer
@inject AuditService Audits
@inject PhotoService Photos
@inject DropdownService Dropdowns

<PageTitle>Overview · @(Model.CompanyName)</PageTitle>

<div class="toolbar">
    <div>
        <h2>Overview</h2>
        <p class="count">Client profile, contacts, and engagement scope.</p>
    </div>
    <button type="button" class="btn btn-primary" @onclick="Save">Save</button>
</div>

@if (!string.IsNullOrEmpty(Message))
{
    <p class="muted">@Message</p>
}

<div class="panel" style="padding:20px">
    <div class="form-grid">
        <div class="full" style="display:flex;gap:16px;align-items:center">
            <div class="client-thumb" style="width:88px;height:88px">
                @if (!string.IsNullOrWhiteSpace(Model.ClientPhotoPath))
                {
                    <img src="/@Model.ClientPhotoPath" alt="Client" />
                }
                else
                {
                    <span>🏢</span>
                }
            </div>
            <label class="btn btn-ghost-dark btn-sm">
                Client photo
                <InputFile OnChange="UploadClientPhoto" accept="image/*" style="display:none" />
            </label>
        </div>

        <label class="fld">Company Name <InputText @bind-Value="Model.CompanyName" /></label>
        <SelectField Label="Industry" @bind-Value="Model.Industry" Options="Industries" />
        <label class="fld">Employee Count <InputNumber @bind-Value="Model.EmployeeCount" /></label>
        <SelectField Label="Audit Status" @bind-Value="Model.Status" Options="Statuses" />
        <label class="fld full">Address <InputText @bind-Value="Model.Address" /></label>
        <label class="fld">Prepared By <InputText @bind-Value="Model.PreparedBy" /></label>
        <label class="fld">Audit Date <InputDate @bind-Value="Model.AuditDate" /></label>
        <label class="fld full">Previous IT Support <InputTextArea @bind-Value="Model.PreviousItSupport" /></label>
        <label class="fld full">Audit Scope <InputTextArea @bind-Value="Model.AuditScope" /></label>
        <label class="fld full">Executive Summary <InputTextArea @bind-Value="Model.ExecutiveSummary" /></label>
    </div>

    <h3 style="margin:22px 0 10px">Contacts</h3>
    @foreach (var role in Enum.GetValues<ContactRole>())
    {
        var contact = Contact(role);
        <h4 style="margin:14px 0 8px">@role contact</h4>
        <div class="form-grid">
            <label class="fld">Name <InputText @bind-Value="contact.Name" /></label>
            <label class="fld">Title <InputText @bind-Value="contact.Title" /></label>
            <label class="fld">Email <InputText @bind-Value="contact.Email" /></label>
            <label class="fld">Phone <InputText @bind-Value="contact.Phone" /></label>
        </div>
    }

    <h3 style="margin:22px 0 10px">Sub-locations</h3>
    @foreach (var loc in Locations)
    {
        <div class="form-grid" style="margin-bottom:10px">
            <label class="fld">Name <InputText @bind-Value="loc.Name" /></label>
            <label class="fld">Address <InputText @bind-Value="loc.Address" /></label>
            <label class="fld full">Notes <InputText @bind-Value="loc.Notes" /></label>
        </div>
    }
    <button type="button" class="btn btn-ghost-dark btn-sm" @onclick="AddLocation">+ Add sub-location</button>
</div>

@code {
    [Parameter] public Guid Id { get; set; }
    private ClientAudit Model { get; set; } = new();
    private List<SubLocation> Locations { get; set; } = [];
    private List<string> Industries { get; set; } = [];
    private List<string> Statuses { get; set; } = [];
    private string? Message { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        Industries = await Dropdowns.OptionsAsync(DropdownKeys.AuditIndustry);
        Statuses = await Dropdowns.OptionsAsync(DropdownKeys.AuditStatus);
        var audit = await Audits.GetAsync(Id);
        if (audit is null) return;
        Model = audit;
        Locations = audit.SubLocations.Count == 0 ? [new SubLocation()] : audit.SubLocations.ToList();
        foreach (var role in Enum.GetValues<ContactRole>())
        {
            if (Model.Contacts.All(c => c.Role != role))
                Model.Contacts.Add(new AuditContact { Role = role, AuditId = Id });
        }
    }

    private AuditContact Contact(ContactRole role) =>
        Model.Contacts.First(c => c.Role == role);

    private void AddLocation() => Locations.Add(new SubLocation { AuditId = Id });

    private async Task Save()
    {
        await Audits.SaveOverviewAsync(Model, Locations);
        Message = "Saved.";
    }

    private async Task UploadClientPhoto(InputFileChangeEventArgs e)
    {
        var file = e.File;
        await using var stream = file.OpenReadStream(8_000_000);
        var photo = await Photos.SaveAsync(Id, stream, file.Name, file.ContentType, "Site Photo", PhotoOwnerTypes.Audit, null, "Client photo");
        Model.ClientPhotoPath = photo.RelativePath;
        await Audits.SaveOverviewAsync(Model, Locations);
    }
}
