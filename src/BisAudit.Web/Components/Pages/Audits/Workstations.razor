@page "/audits/{Id:guid}/workstations"
@layout AuditLayout
@attribute [Authorize]
@rendermode InteractiveServer
@inject AuditService Audits
@inject DropdownService Dropdowns
@inject IJSRuntime Js

<PageTitle>Team & Workstations</PageTitle>

<div class="toolbar">
    <div>
        <h2>Team & Workstations</h2>
        <p class="count">@Items.Count documented items</p>
    </div>
    <button type="button" class="btn btn-primary" @onclick="NewItem">+ Add item</button>
</div>

@if (Items.Count == 0)
{
    <div class="empty">No workstations documented yet.</div>
}

@foreach (var item in Items)
{
    <ItemCard Title="@item.DisplayTitle" Detail="@item.DisplayDetail" PrimaryBadge="@item.Status"
              NeedsAttention="item.NeedsAttention" LastAudited="item.LastAudited"
              OnEdit="() => Edit(item)" OnDelete="() => Delete(item)">
        <PhotoContent>
            <PhotoAttach AuditId="Id" OwnerId="item.Id" OwnerType="@PhotoOwnerTypes.Workstation" Category="Workstation" />
        </PhotoContent>
    </ItemCard>
}

@if (Draft is not null)
{
    <ModalFrame Title="Workstation" OnSave="Save" OnCancel="() => Draft = null">
        <EditForm Model="Draft">
            <div class="form-grid">
                <label class="fld">Device Name <InputText @bind-Value="Draft.DeviceName" /></label>
                <label class="fld">User Name <InputText @bind-Value="Draft.UserName" /></label>
                <label class="fld">Email <InputText @bind-Value="Draft.Email" /></label>
                <label class="fld">Phone <InputText @bind-Value="Draft.Phone" /></label>
                <SelectField Label="Department" @bind-Value="Draft.Department" Options="Departments" />
                <SelectField Label="Work Mode" @bind-Value="Draft.WorkMode" Options="WorkModes" />
                <SelectField Label="Device Type" @bind-Value="Draft.DeviceType" Options="DeviceTypes" />
                <label class="fld">OS <InputText @bind-Value="Draft.OperatingSystem" /></label>
                <label class="fld">Monitors <InputText @bind-Value="Draft.Monitors" /></label>
                <SelectField Label="Status" @bind-Value="Draft.Status" Options="Statuses" />
                <label class="fld full">Hardware Notes <InputTextArea @bind-Value="Draft.HardwareNotes" /></label>
                <label class="fld full">Software <InputTextArea @bind-Value="Draft.Software" /></label>
                <label class="fld">Printer Access <InputText @bind-Value="Draft.PrinterAccess" /></label>
                <label class="fld">Peripherals/Dock <InputText @bind-Value="Draft.PeripheralsDock" /></label>
                <label class="fld full">Issues Reported <InputTextArea @bind-Value="Draft.IssuesReported" /></label>
                <label class="fld full">Recommendations <InputTextArea @bind-Value="Draft.Recommendations" /></label>
                <label class="fld check"><InputCheckbox @bind-Value="Draft.NeedsAttention" /> Needs Attention</label>
            </div>
        </EditForm>
    </ModalFrame>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private List<WorkstationItem> Items { get; set; } = [];
    private WorkstationItem? Draft { get; set; }
    private List<string> Departments { get; set; } = [];
    private List<string> WorkModes { get; set; } = [];
    private List<string> DeviceTypes { get; set; } = [];
    private List<string> Statuses { get; set; } = [];

    protected override async Task OnParametersSetAsync()
    {
        Departments = await Dropdowns.OptionsAsync(DropdownKeys.WorkstationDepartment);
        WorkModes = await Dropdowns.OptionsAsync(DropdownKeys.WorkstationWorkMode);
        DeviceTypes = await Dropdowns.OptionsAsync(DropdownKeys.WorkstationDeviceType);
        Statuses = await Dropdowns.OptionsAsync(DropdownKeys.WorkstationStatus);
        await Reload();
    }

    private async Task Reload()
    {
        var audit = await Audits.GetAsync(Id);
        Items = audit?.Workstations.OrderBy(w => w.UserName).ThenBy(w => w.DeviceName).ToList() ?? [];
    }

    private void NewItem() => Draft = new WorkstationItem { AuditId = Id, Status = "Current", WorkMode = "Onsite" };
    private void Edit(WorkstationItem item) => Draft = Clone(item);

    private async Task Save()
    {
        if (Draft is null) return;
        await Audits.SaveItemAsync(Draft);
        Draft = null;
        await Reload();
    }

    private async Task Delete(WorkstationItem item)
    {
        if (!await Js.InvokeAsync<bool>("confirm", "Delete this workstation?")) return;
        await Audits.DeleteItemAsync<WorkstationItem>(item.Id);
        await Reload();
    }

    private static WorkstationItem Clone(WorkstationItem s) => new()
    {
        Id = s.Id, AuditId = s.AuditId, DeviceName = s.DeviceName, UserName = s.UserName, Email = s.Email,
        Phone = s.Phone, Department = s.Department, WorkMode = s.WorkMode, DeviceType = s.DeviceType,
        OperatingSystem = s.OperatingSystem, Monitors = s.Monitors, HardwareNotes = s.HardwareNotes,
        Software = s.Software, PrinterAccess = s.PrinterAccess, PeripheralsDock = s.PeripheralsDock,
        IssuesReported = s.IssuesReported, Recommendations = s.Recommendations, Status = s.Status,
        LastAudited = s.LastAudited, NeedsAttention = s.NeedsAttention
    };
}
