@page "/audits/{Id:guid}/servers"
@layout AuditLayout
@attribute [Authorize]
@rendermode InteractiveServer
@inject AuditService Audits
@inject DropdownService Dropdowns
@inject IJSRuntime Js

<PageTitle>Servers, Storage & Cloud</PageTitle>

<div class="toolbar">
    <div>
        <h2>Servers, Storage & Cloud</h2>
        <p class="count">@Items.Count documented items</p>
    </div>
    <button type="button" class="btn btn-primary" @onclick="NewItem">+ Add item</button>
</div>

@if (Items.Count == 0) { <div class="empty">No servers, storage, or cloud items documented yet.</div> }

@foreach (var item in Items)
{
    <ItemCard Title="@item.DisplayTitle" Detail="@item.DisplayDetail" PrimaryBadge="@item.Category" SecondaryBadge="@item.Status"
              NeedsAttention="item.NeedsAttention" LastAudited="item.LastAudited"
              OnEdit="() => Edit(item)" OnDelete="() => Delete(item)">
        <PhotoContent>
            <PhotoAttach AuditId="Id" OwnerId="item.Id" OwnerType="@PhotoOwnerTypes.ServerStorage" Category="Server/Storage" />
        </PhotoContent>
    </ItemCard>
}

@if (Draft is not null)
{
    <ModalFrame Title="Server / storage / cloud" OnSave="Save" OnCancel="() => Draft = null">
        <div class="form-grid">
            <label class="fld">Device Name <InputText @bind-Value="Draft.DeviceName" /></label>
            <SelectField Label="Category" @bind-Value="Draft.Category" Options="Categories" />
            <SelectField Label="Direction" @bind-Value="Draft.Direction" Options="Directions" />
            <SelectField Label="Status" @bind-Value="Draft.Status" Options="Statuses" />
            <label class="fld full">Current State <InputTextArea @bind-Value="Draft.CurrentState" /></label>
            <label class="fld full">Risk / Recommendation <InputTextArea @bind-Value="Draft.RiskRecommendation" /></label>
            <label class="fld check"><InputCheckbox @bind-Value="Draft.NeedsAttention" /> Needs Attention</label>
        </div>
    </ModalFrame>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private List<ServerStorageItem> Items { get; set; } = [];
    private ServerStorageItem? Draft { get; set; }
    private List<string> Categories { get; set; } = [];
    private List<string> Directions { get; set; } = [];
    private List<string> Statuses { get; set; } = [];

    protected override async Task OnParametersSetAsync()
    {
        Categories = await Dropdowns.OptionsAsync(DropdownKeys.ServerCategory);
        Directions = await Dropdowns.OptionsAsync(DropdownKeys.ServerDirection);
        Statuses = await Dropdowns.OptionsAsync(DropdownKeys.ServerStatus);
        await Reload();
    }

    private async Task Reload() => Items = (await Audits.GetAsync(Id))?.ServerStorageItems.ToList() ?? [];
    private void NewItem() => Draft = new ServerStorageItem { AuditId = Id, Status = "Current" };
    private void Edit(ServerStorageItem item) => Draft = new ServerStorageItem
    {
        Id = item.Id, AuditId = item.AuditId, DeviceName = item.DeviceName, Category = item.Category,
        CurrentState = item.CurrentState, RiskRecommendation = item.RiskRecommendation, Direction = item.Direction,
        Status = item.Status, LastAudited = item.LastAudited, NeedsAttention = item.NeedsAttention
    };

    private async Task Save()
    {
        if (Draft is null) return;
        await Audits.SaveItemAsync(Draft);
        Draft = null;
        await Reload();
    }

    private async Task Delete(ServerStorageItem item)
    {
        if (!await Js.InvokeAsync<bool>("confirm", "Delete this item?")) return;
        await Audits.DeleteItemAsync<ServerStorageItem>(item.Id);
        await Reload();
    }
}
