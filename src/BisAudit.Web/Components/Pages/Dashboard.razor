@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@inject AuditService Audits
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Dashboard · BIS Client IT Audit</PageTitle>

<GlobalHeader OnNewAudit="() => ShowNew = true" />

<div class="content">
    <div class="stats-row">
        <div class="stat-card"><label>Active audits</label><strong>@ActiveCount</strong></div>
        <div class="stat-card"><label>Open critical / high</label><strong>@CriticalHigh</strong></div>
        <div class="stat-card"><label>Completed audits</label><strong>@CompletedCount</strong></div>
    </div>

    <div class="section-head">
        <div>
            <h2>Client audits</h2>
            <p>A live pulse across every engagement.</p>
        </div>
    </div>

    @if (Items.Count == 0)
    {
        <div class="empty">No audits yet. Create one to start an engagement.</div>
    }
    else
    {
        <div class="audit-grid">
            @foreach (var audit in Items)
            {
                var progress = ProgressCalculator.Calculate(audit);
                var open = ProgressCalculator.OpenIssueCount(audit.Issues);
                <article class="audit-card">
                    <div class="audit-card-top">
                        <div style="display:flex;gap:12px">
                            <div class="client-thumb">
                                @if (!string.IsNullOrWhiteSpace(audit.ClientPhotoPath))
                                {
                                    <img src="/@audit.ClientPhotoPath" alt="" />
                                }
                                else
                                {
                                    <span>🏢</span>
                                }
                            </div>
                            <div>
                                <h3>@audit.CompanyName</h3>
                                <p class="muted">@audit.Industry · @(audit.EmployeeCount ?? 0) employees</p>
                            </div>
                        </div>
                        <StatusBadge Value="@audit.Status" />
                    </div>
                    <div>
                        <div class="progress-row"><span>Audit progress</span><span>@progress.Percent%</span></div>
                        <div class="progress"><span style="width:@(progress.Percent)%"></span></div>
                    </div>
                    <div class="card-foot">
                        <span class="open-items @(open == 0 ? "zero" : null)">@open open items</span>
                        <div class="icon-row">
                            <a class="btn btn-ghost-dark btn-icon" href="@($"/reports/{audit.Id}")" title="Client Report">📄</a>
                            <button type="button" class="btn btn-ghost-dark btn-icon" title="Duplicate" @onclick="() => Duplicate(audit.Id)">⧉</button>
                            <a class="btn btn-ghost-dark btn-icon" href="@($"/audits/{audit.Id}/overview")" title="Open">→</a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>

@if (ShowNew)
{
    <ModalFrame Title="New audit" SaveLabel="Create audit" OnSave="Create" OnCancel="() => ShowNew = false">
        <label class="fld full">
            Company name
            <InputText @bind-Value="NewName" />
        </label>
        <p class="muted">Status will be Planning, audit date today, industry Marketing. You can change these on Overview.</p>
    </ModalFrame>
}

@code {
    private List<ClientAudit> Items { get; set; } = [];
    private bool ShowNew { get; set; }
    private string NewName { get; set; } = "";
    private int ActiveCount => Items.Count(ProgressCalculator.IsActive);
    private int CompletedCount => Items.Count(a => !ProgressCalculator.IsActive(a));
    private int CriticalHigh => Items.Sum(a => ProgressCalculator.OpenCriticalHighCount(a.Issues));

    protected override async Task OnInitializedAsync()
    {
        await Reload();
        var uri = new Uri(Nav.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).ContainsKey("new"))
            ShowNew = true;
    }

    private async Task Reload() => Items = await Audits.ListSummariesAsync();

    private async Task Create()
    {
        if (string.IsNullOrWhiteSpace(NewName)) return;
        var audit = await Audits.CreateAsync(NewName);
        Nav.NavigateTo($"/audits/{audit.Id}/overview");
    }

    private async Task Duplicate(Guid id)
    {
        if (!await Js.InvokeAsync<bool>("confirm", "Duplicate this audit?")) return;
        var copy = await Audits.DuplicateAsync(id);
        Nav.NavigateTo($"/audits/{copy.Id}/overview");
    }
}
