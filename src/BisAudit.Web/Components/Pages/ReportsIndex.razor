@page "/reports"
@attribute [Authorize]
@rendermode InteractiveServer
@inject AuditService Audits

<PageTitle>Client Reports · BIS Client IT Audit</PageTitle>
<GlobalHeader />

<div class="content">
    <div class="section-head">
        <div>
            <h2>Client Reports</h2>
            <p>Printable summaries with cost-of-inaction, investment, and payback.</p>
        </div>
    </div>
    <table class="data">
        <thead>
        <tr>
            <th>Company</th>
            <th>Status</th>
            <th>Open issues</th>
            <th>Critical / high</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var audit in Items)
        {
            var metrics = ReportMetrics.From(audit);
            <tr>
                <td>@audit.CompanyName</td>
                <td><StatusBadge Value="@audit.Status" /></td>
                <td>@metrics.OpenIssueCount</td>
                <td>@metrics.CriticalHighCount</td>
                <td><a class="btn btn-primary btn-sm" href="@($"/reports/{audit.Id}")">Open report</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    private List<ClientAudit> Items { get; set; } = [];
    protected override async Task OnInitializedAsync() => Items = await Audits.ListSummariesAsync();
}
