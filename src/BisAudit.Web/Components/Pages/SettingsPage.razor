@page "/settings"
@attribute [Authorize]
@rendermode InteractiveServer
@inject DropdownService Dropdowns

<PageTitle>Dropdown Settings · BIS Client IT Audit</PageTitle>

<header class="app-header">
    <div class="app-brand">
        <a class="btn btn-ghost btn-icon" href="/" title="Back">←</a>
        <div>
            <h1>Dropdown Settings</h1>
            <p>Edit the options available in dropdown menus across all audit modules.</p>
        </div>
    </div>
</header>

<div class="content">
    <p class="muted" style="margin-bottom:18px">
        Changes apply immediately to new and existing records. One panel per list — add, remove, then save.
    </p>

    @foreach (var list in Lists)
    {
        <section class="panel" style="padding:18px 20px;margin-bottom:16px">
            <div class="toolbar">
                <h3 style="margin:0">@list.DisplayName</h3>
                <button type="button" class="btn btn-primary btn-sm" @onclick="() => Save(list)">💾 Save</button>
            </div>
            <div class="chip-row">
                @foreach (var option in list.Draft)
                {
                    <span class="chip">
                        @option
                        <button type="button" title="Remove" @onclick="() => list.Draft.Remove(option)">×</button>
                    </span>
                }
                <span class="chip chip-add">
                    <input @bind="list.NewValue" @bind:event="oninput" placeholder="Add option" style="border:0;background:transparent;width:140px" />
                    <button type="button" @onclick="() => Add(list)">+ Add</button>
                </span>
            </div>
            @if (list.Message is not null)
            {
                <p class="muted" style="margin-top:10px">@list.Message</p>
            }
        </section>
    }
</div>

@code {
    private List<EditableList> Lists { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        var source = await Dropdowns.GetAllAsync();
        Lists = source.Select(l => new EditableList
        {
            Id = l.Id,
            DisplayName = l.DisplayName,
            Draft = l.Options.OrderBy(o => o.SortOrder).Select(o => o.Value).ToList()
        }).ToList();
    }

    private static void Add(EditableList list)
    {
        if (string.IsNullOrWhiteSpace(list.NewValue)) return;
        if (!list.Draft.Contains(list.NewValue.Trim(), StringComparer.OrdinalIgnoreCase))
            list.Draft.Add(list.NewValue.Trim());
        list.NewValue = "";
    }

    private async Task Save(EditableList list)
    {
        await Dropdowns.SaveListAsync(list.Id, list.Draft);
        list.Message = "Saved.";
    }

    private sealed class EditableList
    {
        public Guid Id { get; set; }
        public string DisplayName { get; set; } = "";
        public List<string> Draft { get; set; } = [];
        public string NewValue { get; set; } = "";
        public string? Message { get; set; }
    }
}
