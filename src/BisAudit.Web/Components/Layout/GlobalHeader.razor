@inject NavigationManager Nav

<header class="app-header">
    <a class="app-brand" href="/">
        <span class="brand-mark">🛡️</span>
        <div>
            <h1>BIS Client IT Audit</h1>
            <p>Infrastructure assurance workspace</p>
        </div>
    </a>
    <div class="header-actions">
        @if (ShowNavActions)
        {
            <a class="btn btn-ghost" href="/reports">Client Reports</a>
            <a class="btn btn-ghost" href="/settings">Settings</a>
            @if (OnNewAudit.HasDelegate)
            {
                <button type="button" class="btn btn-light" @onclick="OnNewAudit">+ New audit</button>
            }
            else
            {
                <a class="btn btn-light" href="/?new=1">+ New audit</a>
            }
        }
        <form action="Account/Logout" method="post">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="/" />
            <button type="submit" class="btn btn-ghost">Sign out</button>
        </form>
    </div>
</header>

@code {
    [Parameter] public bool ShowNavActions { get; set; } = true;
    [Parameter] public EventCallback OnNewAudit { get; set; }
}
